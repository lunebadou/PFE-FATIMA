# Copiez ce fichier en ".env" et adaptez si besoin (tout est facultatif).

# Port du serveur (API + interface)
PORT=5000

# Broker MQTT où l'ESP32 publie ses mesures
MQTT_ENABLED=1
MQTT_BROKER=209.38.68.161
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=incendie/data

# Seuil de gaz (ppm) déclenchant une alerte "fuite de gaz"
GAS_THRESHOLD=300

# Délai (secondes) sans message avant d'afficher l'ESP32 "hors ligne"
DEVICE_TIMEOUT_SECONDS=60

# Facultatif : clé exigée pour envoyer des mesures en HTTP (POST /api/data, en-tête X-Device-Key)
DEVICE_KEY=
